{
  "scripts": {
    "dev": "next dev -H 0.0.0.0",
    "build": "next build",
    "start": "npx serve out -l 3000",
    "typecheck": "tsc --noEmit",
    "db:migrate:local": "wrangler d1 migrations apply opuszim-content --local",
    "db:migrations:list": "wrangler d1 migrations list opuszim-content --remote",
    "db:migrate:remote": "wrangler d1 migrations apply opuszim-content --remote",
    "db:backup:remote": "wrangler d1 export opuszim-content --remote --output=backups/opuszim-content.sql",
    "db:verify:remote": "wrangler d1 execute opuszim-content --remote --file=scripts/remote-verify.sql",
    "db:check": "node scripts/db-check.mjs",
    "pages:local": "wrangler pages dev --port 8788 --ip 0.0.0.0",
    "checks": "npm run typecheck && npm run build && npm run db:migrate:local && npm run db:check"
  },
  "dependencies": {
    "@cloudflare/puppeteer": "^1.4.0",
    "@fontsource/poppins": "5.3.0",
    "@pdf-lib/fontkit": "^1.1.1",
    "framer-motion": "^11.11.17",
    "lucide-react": "^0.468.0",
    "next": "14.2.5",
    "pdf-lib": "^1.17.1",
    "pesepay": "2.0.0",
    "react": "18.3.1",
    "react-dom": "18.3.1"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "autoprefixer": "^10",
    "postcss": "^8",
    "tailwindcss": "^3.4.10",
    "typescript": "^5",
    "wrangler": "^4.141.0"
  }
}
